diff --git a/kernel/feature/kernel_umount.c b/kernel/feature/kernel_umount.c
index 1d8cd81b..feac1ab9 100644
--- a/kernel/feature/kernel_umount.c
+++ b/kernel/feature/kernel_umount.c
@@ -116,6 +116,11 @@ static inline int ksu_handle_umount(struct cred *new, const struct cred *old)
 
 	const struct cred *saved = override_creds(ksu_cred);
 
+#ifdef CONFIG_KSU_SUSFS_TRY_UMOUNT
+	// susfs comes first, and lastly umount by ksu, make sure umount in reversed order
+	susfs_try_umount(new_uid);
+#endif
+
 	struct mount_entry *entry;
 	down_read(&mount_list_lock);
 	list_for_each_entry (entry, &mount_list, list) {
diff --git a/kernel/ksu.c b/kernel/ksu.c
index fe5256ed..ac9a5de5 100644
--- a/kernel/ksu.c
+++ b/kernel/ksu.c
@@ -42,6 +42,10 @@
 #include "include/klog.h"
 #include "include/ksu.h"
 
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
