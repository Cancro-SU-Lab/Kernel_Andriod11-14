--- a/kernel/selinux/rules.c
+++ b/kernel/selinux/rules.c
@@ -145,6 +145,11 @@ static int apply_kernelsu_rules_fn(void *ptr)
 	ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "getopt");
